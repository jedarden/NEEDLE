# CI builder image for the NEEDLE Rust pipeline.
#
# Version contract: the tag produced from this image comes from ci/VERSION, and
# every consumer template in declarative-config pins
# ronaldraygun/needle-ci-builder:<ci/VERSION>-with-deps by digest. Bump
# ci/VERSION with image content changes, then repin the consumers after both
# new image tags publish. Never point CI at a tag before it exists.
#
# Build trigger: the needle-ci-builder WorkflowTemplate's check-changed-files
# step only rebuilds when the pushed commit touches Cargo.toml, Cargo.lock,
# rust-toolchain.toml, ci/Dockerfile.ci, ci/Dockerfile.ci-deps or ci/VERSION.
# A no-op edit to this file is therefore the way to force a rebuild without
# disturbing that contract.
# Rebuild marker (2026-09-12): replay 0.1.8 after exact-revision diffing landed.
# Rebuild marker (2026-09-12, retry 2): the first replay was externally
# superseded after the base tag published and before with-deps could start.
# Rebuild marker (2026-09-12, retry 3): the dependency-stub repair push reached
# Forgejo but its webhook event never reached the Argo Events sensor.
# Rebuild marker (2026-09-12, retry 4): GitHub delivery resumed after the
# webhooks-ci ingress received a hostname-valid cert-manager certificate.
# Rebuild marker (2026-09-12, retry 5): the public Cloudflare DNS record is
# now authoritative in addition to the tailnet-only split-DNS record.
#
# After triggering, confirm BOTH tags moved -- the template runs docker-build-base
# and docker-build-with-deps as separate kaniko steps, and a run that is stopped
# between them (or whose workflow object is reaped mid-flight) leaves
# ronaldraygun/needle-ci-builder:<version>-with-deps pointing at an older image.
# `docker manifest inspect <image>:<tag>` reports the config blob's `created`
# timestamp, which is the cheapest way to check.

FROM debian:bookworm

# System deps. gcc-aarch64-linux-gnu is the release stage's aarch64
# cross-linker: the needle-ci workflow used to apt-get it at run time, which
# is exactly the from-scratch provisioning this image exists to remove
# (bead needle-be43ddfa). Bake it here instead.
RUN apt-get update && apt-get install -y \
    git curl jq build-essential pkg-config libssl-dev \
    gcc-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*

# The P2 fallback-gate integration tests run real Go builds. Keep the
# toolchain in the base image so both the builder and test shards use it.
# Checksum: https://go.dev/dl/ (go1.26.8.linux-amd64.tar.gz).
ARG GO_VERSION=1.26.8
ARG GO_ARCHIVE_SHA256=d0f743b33e8d8945e6b1f432edd15785c70507121d6e2a723b21285eddf8b57b
RUN set -eux; \
    archive="go${GO_VERSION}.linux-amd64.tar.gz"; \
    curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-all-errors \
      "https://go.dev/dl/${archive}" -o "/tmp/${archive}"; \
    echo "${GO_ARCHIVE_SHA256}  /tmp/${archive}" | sha256sum --check --strict; \
    tar -C /usr/local -xzf "/tmp/${archive}"; \
    rm -f "/tmp/${archive}"; \
    test "$(/usr/local/go/bin/go version)" = "go version go${GO_VERSION} linux/amd64"
ENV PATH="/usr/local/go/bin:${PATH}"

# Keep the compiler cache available without making every CI pod download an
# executable from GitHub before it can start useful work. The checksum is tied
# to the pinned release and must be updated together with SCCACHE_VERSION.
ARG SCCACHE_VERSION=0.17.0
ARG SCCACHE_SHA256=67c4a96dd237c1f518f6b36083f270f9976d516f1e57fce891755ea782e50006
RUN set -eux; \
    archive="sccache-v${SCCACHE_VERSION}-x86_64-unknown-linux-musl.tar.gz"; \
    root="/tmp/sccache-${SCCACHE_VERSION}"; \
    curl --proto '=https' --tlsv1.2 -fsSL --retry 3 \
      "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/${archive}" \
      -o "/tmp/${archive}"; \
    echo "${SCCACHE_SHA256}  /tmp/${archive}" | sha256sum --check --strict; \
    mkdir -p "${root}"; \
    tar -xzf "/tmp/${archive}" --strip-components=1 -C "${root}"; \
    install -m 0755 "${root}/sccache" /usr/local/bin/sccache; \
    rm -rf "/tmp/${archive}" "${root}"; \
    test "$(sccache --version)" = "sccache ${SCCACHE_VERSION}"

# Install gh CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg 2>/dev/null \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# Install Rust stable
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Bake the toolchain NEEDLE actually builds with, so the first cargo call in
# a NEEDLE checkout resolves offline instead of rustup-downloading the
# toolchain, its components and its targets separately in every CI pod --
# verify-fast plus all five test pods each paid that on every run.
#
# This MUST mirror rust-toolchain.toml at the repo root: channel, components
# and targets. rustup re-checks all three against that file on every
# invocation and downloads whatever is missing, so a bake that drifts from
# the file is silently undone per pod. aarch64-unknown-linux-gnu is not in
# rust-toolchain.toml but is what the release stage's cross-build links
# against -- previously installed at run time by `rustup target add` in the
# workflow, which is gone for the same reason the apt-get is.
#
# `stable` stays the default above on purpose: rust-verify and rust-ci point
# arbitrary repos at this image, and a repo without a rust-toolchain.toml
# should keep building on stable rather than on NEEDLE's pin.
#
# If rust-toolchain.toml moves, change the pin here AND bump ci/VERSION in
# the same commit -- rust-toolchain.toml is in the builder template's
# check-changed-files trigger list precisely so a pin move rebuilds this
# image; without the bump the pins in declarative-config keep pointing at a
# tag that was never rebuilt.
RUN rustup toolchain install 1.95.0 \
    --profile minimal \
    --component rustfmt --component clippy \
    --target x86_64-unknown-linux-gnu \
    --target aarch64-apple-darwin \
    --target aarch64-unknown-linux-gnu

# Archive one compiled test build and reuse it in low-memory runner pods. Keep
# this addition after the expensive pinned-toolchain layer so a nextest-only
# image change preserves the previously published toolchain cache lineage. Pin
# both the release tarball and the extracted executable: the first protects the
# download boundary, while the second catches an upstream asset being repacked
# with different contents under the same filename.
ARG CARGO_NEXTEST_VERSION=0.9.144
ARG CARGO_NEXTEST_ARCHIVE_SHA256=20ed0a7d3d6f8dda9bb1b0bcb5838aea5784d3e2360746280868996d709dde0a
ARG CARGO_NEXTEST_BINARY_SHA256=92e0def8d330c7bb295175a998ad73f65670dc3d216d1ae7a28f286d130ce1ad
RUN set -eux; \
    archive="cargo-nextest-${CARGO_NEXTEST_VERSION}-x86_64-unknown-linux-musl.tar.gz"; \
    root="/tmp/cargo-nextest-${CARGO_NEXTEST_VERSION}"; \
    curl --proto '=https' --tlsv1.2 -fsSL --retry 5 --retry-all-errors \
      "https://github.com/nextest-rs/nextest/releases/download/cargo-nextest-${CARGO_NEXTEST_VERSION}/${archive}" \
      -o "/tmp/${archive}"; \
    echo "${CARGO_NEXTEST_ARCHIVE_SHA256}  /tmp/${archive}" | sha256sum --check --strict; \
    mkdir -p "${root}"; \
    tar -xzf "/tmp/${archive}" -C "${root}"; \
    echo "${CARGO_NEXTEST_BINARY_SHA256}  ${root}/cargo-nextest" | sha256sum --check --strict; \
    install -m 0755 "${root}/cargo-nextest" /usr/local/bin/cargo-nextest; \
    cargo-nextest --version | grep -Fx "release: ${CARGO_NEXTEST_VERSION}"; \
    rm -rf "/tmp/${archive}" "${root}"

# The P2/P3 integration fixtures invoke bead-rs at test runtime. Bake it into
# the builder so six parallel verification pods do not each fetch the same
# executable before useful work can start. This must stay in lockstep with
# NEEDLE's bead-rs compatibility contract.
#
# Built from a pinned source revision, not the v0.2.6 release binary: that
# release (tag d9a32b3) predates bead-rs 7addba8, so `bead update --status
# in_progress --assignee` mints no claim_epoch, and NEEDLE's pre-spawn claim
# verification (421a4748) fails closed on every update-path claim. The rev is
# the bead-rs main commit the fleet runs; both carry version string 0.2.6.
# Move to a release asset again once a bead-rs release includes 7addba8.
# Kept after the toolchain layers so a bead-rs bump preserves their cache.
ARG BEAD_RS_VERSION=0.2.6
ARG BEAD_RS_REV=e0bd976c3c7901b5af7b785c317d33c87362d33b
RUN set -eux; \
    CARGO_HOME=/tmp/bead-rs-cargo CARGO_BUILD_JOBS=2 cargo +stable install --locked \
      --git https://github.com/jedarden/bead-rs.git --rev "${BEAD_RS_REV}" \
      --bin bead --root /usr/local bead-rs; \
    rm -rf /tmp/bead-rs-cargo; \
    test "$(bead --version | cut -d' ' -f1-2)" = "bead ${BEAD_RS_VERSION}"

WORKDIR /workspace
