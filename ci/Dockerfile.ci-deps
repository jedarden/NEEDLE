ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Pre-compile all dependencies.
# Copy only Cargo.toml/Cargo.lock first, create dummy source, build deps.
# This layer is cached unless Cargo.toml/Cargo.lock change.
#
# Every target Cargo.toml declares needs a stub here, including [[bench]]
# entries -- `cargo build` fails to even parse the manifest if a declared
# target's source file is missing (confirmed live 2026-08-12: "can't find
# `sanitize` bench at `benches/sanitize.rs`"), not just the lib/bin targets
# that were stubbed before.
COPY Cargo.toml Cargo.lock ./
COPY src/bin/needle_transform_claude.rs ./src/bin/needle_transform_claude.rs
COPY src/bin/needle_transform_codex.rs ./src/bin/needle_transform_codex.rs
RUN mkdir -p src benches && \
    echo "pub fn _dummy() {}" > src/lib.rs && \
    echo "fn main() {}" > src/main.rs && \
    echo "fn main() {}" > src/bin/needle_transform_claude.rs && \
    echo "fn main() {}" > src/bin/needle_transform_codex.rs && \
    echo "fn main() {}" > benches/sanitize.rs && \
    cargo build && \
    cargo build --tests && \
    rm -rf src benches

WORKDIR /workspace
