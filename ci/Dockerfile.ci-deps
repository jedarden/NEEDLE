ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Pre-compile all dependencies. Keep the resulting target tree outside
# /workspace: every workflow pod mounts a checkout volume there, which hides
# image-layer files at that path. Jobs recreate the same absolute target
# symlink after checkout, making these warmed artifacts visible to Cargo.
#
# rust-toolchain.toml is part of this layer because Cargo selects the compiler
# from the source tree. Record the exact release that produced the artifacts so
# jobs can reject an image/source/compiler mismatch instead of reusing an
# incompatible target tree.
WORKDIR /workspace
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .config/nextest.toml ./.config/nextest.toml
RUN set -eux; \
    source_toolchain="$(sed -n 's/^[[:space:]]*channel[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' rust-toolchain.toml)"; \
    actual_toolchain="$(rustc -vV | sed -n 's/^release: //p')"; \
    test -n "$source_toolchain"; \
    test -n "$actual_toolchain"; \
    test "$source_toolchain" = "$actual_toolchain"; \
    printf '%s\n' "$actual_toolchain" > /opt/needle-ci-toolchain-version; \
    mkdir -p /opt/needle-ci-target; \
    ln -s /opt/needle-ci-target /workspace/target

# Create dummy source and build dependencies. This layer is cached unless the
# manifest, lockfile, pinned toolchain, or explicit target inventory changes.
#
# Every target Cargo.toml declares needs a stub here, including [[bench]] and
# [[test]] entries -- cargo fails to load the manifest if a declared target's
# source file is missing: "can't find `sanitize` bench at `benches/sanitize.rs`"
# (confirmed live 2026-08-12), "can't find integration-test `integration_spawn`
# at path `tests/integration_spawn.rs`" (confirmed live 2026-09-06). Create all
# stubs inside this layer rather than COPYing volatile NEEDLE source into the
# dependency cache.
#
# `cargo build --tests` still uses Cargo's dev profile. The archive producer is
# driven by nextest, whose build command uses the test profile; those profile
# hashes are intentionally distinct. Warm with the producer's exact nextest
# command, feature set and six-target inventory so only NEEDLE workspace
# targets need recompilation after the real source checkout replaces the stubs.
RUN mkdir -p src/bin benches tests && \
    echo "fn main() {}" > build.rs && \
    echo "pub fn _dummy() {}" > src/lib.rs && \
    echo "fn main() {}" > src/main.rs && \
    echo "fn main() {}" > src/bin/needle_transform_claude.rs && \
    echo "fn main() {}" > src/bin/needle_transform_codex.rs && \
    echo "fn main() {}" > src/bin/needle_transform_opencode.rs && \
    echo "fn main() {}" > src/bin/needle_transform_omp.rs && \
    echo "fn main() {}" > benches/sanitize.rs && \
    echo "fn main() {}" > tests/integration_spawn.rs && \
    echo "fn main() {}" > tests/integration_tests.rs && \
    echo "fn main() {}" > tests/p2_integration_tests.rs && \
    echo "fn main() {}" > tests/p3_integration_tests.rs && \
    echo "fn main() {}" > tests/real_br_integration_tests.rs && \
    echo "fn main() {}" > tests/escalation_ladder.rs && \
    echo "fn main() {}" > tests/nt45_failure_evidence_capture.rs && \
    echo "fn main() {}" > tests/nt50_exception_lessons.rs && \
    echo "fn main() {}" > tests/nt51_adapter_usage_capture.rs && \
    echo "fn main() {}" > tests/nt51_gateway_health.rs && \
    echo "fn main() {}" > tests/nt52_state_dir_isolation.rs && \
    echo "fn main() {}" > tests/nt07_admission_policy.rs && \
    echo "fn main() {}" > tests/nt07_admission_budgets.rs && \
    echo "fn main() {}" > tests/nt53_improvement_proposals.rs && \
    echo "fn main() {}" > tests/nt07_proposal_contract.rs && \
    echo "fn main() {}" > tests/nt07_impact_contract.rs && \
    echo "fn main() {}" > tests/nt07_impact_scoring.rs && \
    echo "fn main() {}" > tests/nt07_executable_admission.rs && \
    CARGO_BUILD_JOBS=2 cargo-nextest nextest archive \
      --archive-file /tmp/needle-nextest-dependency-warm.tar.zst \
      --profile ci \
      --locked \
      --lib \
      --test integration_spawn \
      --test integration_tests \
      --test p2_integration_tests \
      --test p3_integration_tests \
      --test real_br_integration_tests \
      --test escalation_ladder \
      --test nt45_failure_evidence_capture \
      --test nt50_exception_lessons \
      --test nt51_adapter_usage_capture \
      --test nt51_gateway_health \
      --test nt52_state_dir_isolation \
      --test nt07_admission_policy \
      --test nt07_admission_budgets \
      --test nt53_improvement_proposals \
      --test nt07_proposal_contract \
      --test nt07_impact_contract \
      --test nt07_impact_scoring \
      --test nt07_executable_admission && \
    rm -f /tmp/needle-nextest-dependency-warm.tar.zst && \
    test -d /opt/needle-ci-target/debug/deps && \
    actual_toolchain="$(rustc -vV | sed -n 's/^release: //p')" && \
    nextest_release="$(cargo-nextest --version | sed -n 's/^release: //p')" && \
    nextest_binary="$(command -v cargo-nextest)" && \
    nextest_binary_sha256="$(sha256sum "$nextest_binary" | awk '{print $1}')" && \
    target_triple="$(rustc -vV | sed -n 's/^host: //p')" && \
    test "$target_triple" = x86_64-unknown-linux-gnu && \
    { \
      printf '%s\n' 'schema=needle-nextest-dependency-cache/v1'; \
      printf 'cargo_toml_sha256=%s\n' "$(sha256sum Cargo.toml | awk '{print $1}')"; \
      printf 'cargo_lock_sha256=%s\n' "$(sha256sum Cargo.lock | awk '{print $1}')"; \
      printf 'rust_toolchain_sha256=%s\n' "$(sha256sum rust-toolchain.toml | awk '{print $1}')"; \
      printf 'nextest_config_sha256=%s\n' "$(sha256sum .config/nextest.toml | awk '{print $1}')"; \
      printf 'rust_release=%s\n' "$actual_toolchain"; \
      printf 'nextest_release=%s\n' "$nextest_release"; \
      printf 'nextest_binary_sha256=%s\n' "$nextest_binary_sha256"; \
      printf '%s\n' 'cargo_profile=test'; \
      printf '%s\n' 'nextest_profile=ci'; \
      printf '%s\n' 'features=default'; \
      printf 'target_triple=%s\n' "$target_triple"; \
      printf '%s\n' 'target_set=lib,integration_spawn,integration_tests,p2_integration_tests,p3_integration_tests,real_br_integration_tests,escalation_ladder,nt45_failure_evidence_capture,nt50_exception_lessons,nt51_adapter_usage_capture,nt51_gateway_health,nt52_state_dir_isolation,nt07_admission_policy,nt07_admission_budgets,nt53_improvement_proposals,nt07_proposal_contract,nt07_impact_contract,nt07_impact_scoring,nt07_executable_admission'; \
      printf '%s\n' 'workspace_root=/workspace'; \
      printf '%s\n' 'target_dir=/opt/needle-ci-target'; \
      printf '%s\n' 'cargo_build_jobs=2'; \
    } > /opt/needle-ci-nextest-cache-contract && \
    test -s /opt/needle-ci-nextest-cache-contract && \
    rm /workspace/target && \
    rm -rf src benches tests

WORKDIR /workspace
