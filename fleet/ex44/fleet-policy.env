# Shared non-secret worker policy. Installed as
# ~/.config/needle/fleet-policy.env and loaded before each per-worker env.
# Keep the reproducible fleet cap aligned with the manifest: 22 GLM workers,
# eleven GPT-5.6 Luna workers, four GPT-6 Luna workers, and one Anthropic Claude
# worker. The three workers moved off Z.ai use codex-luna-* identifiers so
# their service identities name both the Codex harness and Luna model. The two
# original NEEDLE-homed additions were lane-bound to `learning-loop`; the
# concurrency restoration returns codex-luna-needle-01 to the NEEDLE home so
# the workspace's configured three-worker admission limit has three callers.
# codex-luna-tgplat-01/02 were repointed off tradegraph-platform, which is
# lab-owned (needle-182be85c). The openai bucket
# (limits.providers.openai.max_concurrent in config.yaml) counts REGISTERED
# Codex workers plus the caller, so it must stay above the Codex roster size
# (12 after Step 2A, 15 after Step 2B); it is set to 16.
#
# NOTE (2026-09-16): this key caps the --count of ONE `needle run`
# invocation, not the fleet total -- every worker unit runs --count 1. It is
# manifest bookkeeping, not an enforcement gate; a new worker unit starts
# regardless of this number.
NEEDLE_WORKER__MAX_WORKERS=38
# Poll the layered global configuration at safe cycle boundaries. v0.6.6
# proves this path for both active and exhausted workers; zero disables it.
NEEDLE_WORKER__CONFIG_RELOAD_CHECK_INTERVAL_SECS=30
#
# Exhausted approved queues may idle. Discovery must not manufacture an
# executable backlog to satisfy worker or quota utilization targets.
NEEDLE_STRANDS__GENERATION__ENABLED=false
NEEDLE_STRANDS__GENERATION__LOW_WATER_RESERVE=0
NEEDLE_STRANDS__GENERATION__LEASE_TTL_SECS=300
NEEDLE_STRANDS__WEAVE__ENABLED=false
NEEDLE_STRANDS__PULSE__ENABLED=false
NEEDLE_STRANDS__UNRAVEL__ENABLED=false

# A full one-hour agent timeout is strong evidence that a task is too large.
# Split those attempts immediately; gate/handler timeouts remain excluded
# because they usually describe infrastructure or suite cost, not task scope.
NEEDLE_STRANDS__MITOSIS__TIMEOUT_TRIGGERED__ENABLED=true
NEEDLE_STRANDS__MITOSIS__TIMEOUT_TRIGGERED__AGENT_WALLCLOCK_TIMEOUT=true
NEEDLE_STRANDS__MITOSIS__TIMEOUT_TRIGGERED__HANDLER_TIMEOUT=false
NEEDLE_STRANDS__MITOSIS__TIMEOUT_TRIGGERED__MIN_ELAPSED_FRACTION=0.9
