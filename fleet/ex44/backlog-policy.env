# Fleetwide eligible-backlog SLO for 27 workers.
# 108 = four immediately eligible beads per worker.
# 54 = two per worker; crossing it is the alert threshold.
FLEET_WORKER_TARGET=27
FLEET_ELIGIBLE_TARGET=108
FLEET_ELIGIBLE_MINIMUM=54
ELIGIBLE_TARGET_PER_WORKER=4
ELIGIBLE_MINIMUM_PER_WORKER=2
WORKSPACE_ELIGIBLE_RESERVE=6
