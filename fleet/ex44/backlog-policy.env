# Fleetwide eligible-backlog SLO for 21 workers.
# 84 = four immediately eligible beads per worker.
# 42 = two per worker; crossing it is the alert threshold.
FLEET_WORKER_TARGET=21
FLEET_ELIGIBLE_TARGET=84
FLEET_ELIGIBLE_MINIMUM=42
ELIGIBLE_TARGET_PER_WORKER=4
ELIGIBLE_MINIMUM_PER_WORKER=2
WORKSPACE_ELIGIBLE_RESERVE=6
