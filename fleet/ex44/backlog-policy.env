# Fleetwide eligible-backlog SLO for 25 workers.
# 100 = four immediately eligible beads per worker.
# 50 = two per worker; crossing it is the alert threshold.
FLEET_WORKER_TARGET=25
FLEET_ELIGIBLE_TARGET=100
FLEET_ELIGIBLE_MINIMUM=50
ELIGIBLE_TARGET_PER_WORKER=4
ELIGIBLE_MINIMUM_PER_WORKER=2
WORKSPACE_ELIGIBLE_RESERVE=6
