[Unit]
Description=Run the factory-health audit once a day

[Timer]
# Once per host per day, never once per worker (needle-a0d1eb19): every
# worker runs the same waterfall, so a per-worker audit would produce N
# duplicate findings and N concurrent readers.
OnCalendar=*-*-* 07:40:00 America/New_York
RandomizedDelaySec=10m
# A host that was down through the window audits at the next boot rather
# than skipping the day.
Persistent=true

[Install]
WantedBy=timers.target
