[Unit]
Description=NEEDLE worker %i
After=default.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
Slice=needle.slice
WorkingDirectory=/home/coding

# Per-worker blast radius (2026-09-20). needle.slice caps the fleet at 24G/34G,
# but each instance was uncapped, so one worker could consume the whole fleet
# budget. On 2026-09-20 an abandoned `cargo test --bin loom` under glm-loom held
# 18.2G resident plus 9.3G swap — 72% of the slice's MemoryHigh — pinning the
# slice against its cap for seven hours. All 31 workers stalled on reclaim
# (memory.pressure full=77%, load 162 on 20 idle-ish cores) and the process
# faulted 1.7 TB back off disk. One runaway, thirty victims.
#
# Sized from observed per-worker peaks on this fleet: the highest legitimate
# peak was 9.83G (glm-roam-20), most workers peak at 1-4G. MemoryHigh throttles
# with reclaim pressure and no kill; MemoryMax is the wall.
#
# MemorySwapMax is what makes MemoryMax bind. In cgroup v2 memory.max limits RSS
# only — swap is governed separately, so a capped worker would push its overage
# into swap and thrash exactly as above, just more slowly. 2G lets cold pages
# page out without sustaining a thrash loop.
MemoryHigh=8G
MemoryMax=12G
MemorySwapMax=2G

# Instance identity/routing is source-controlled in workers.tsv and rendered by
# apply-ex44-fleet.sh. Credentials stay in the host-only common file.
EnvironmentFile=-%h/.config/needle/worker-common.env
EnvironmentFile=%h/.config/needle/fleet-policy.env
# Instance routing is last so each worker can select its home and Explore mode;
# generation remains fleet-wide and chooses from Explore's approved workspace
# set when the worker is allowed to roam.
EnvironmentFile=%h/.config/needle/workers/%i.env
Environment=NEEDLE_INNER=1
Environment=PATH=/home/coding/.local/bin:/home/coding/.cargo/bin:/home/coding/bin:/run/current-system/sw/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ExecStartPre=/bin/sh -c 'sleep "${NEEDLE_START_DELAY:-0}"'
ExecStart=/home/coding/.needle/bin/needle run --workspace ${NEEDLE_WS} --agent ${NEEDLE_AGENT} --count 1 --identifier %i --timeout 3600

Restart=always
RestartSec=120
TimeoutStartSec=420
TimeoutStopSec=120
KillSignal=SIGINT

[Install]
WantedBy=default.target
