# Approved work may exhaust. Idle capacity does not authorize new tasks.
NEEDLE_WORKER__CONFIG_RELOAD_CHECK_INTERVAL_SECS=30
NEEDLE_STRANDS__GENERATION__ENABLED=false
NEEDLE_STRANDS__GENERATION__LOW_WATER_RESERVE=0
NEEDLE_STRANDS__WEAVE__ENABLED=false
NEEDLE_STRANDS__PULSE__ENABLED=false
NEEDLE_STRANDS__UNRAVEL__ENABLED=false

# Organization secret-scanner parity in bead-rs (beadrs-1c110ec3); off disables.
# Set on the host since 2026-10-03 but missing here, so a converge would have
# dropped it (needle-803b9ff4).
BEAD_ORG_SECRET_SCANNER=/home/coding/.local/bin/secret-scanner
