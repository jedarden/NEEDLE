# NEEDLE fleet slice for lab (bare-metal NixOS, 12 logical cores).
#
# Source-controlled copy of the unit deployed at
# ~/.config/systemd/user/needle.slice plus the drop-ins that historically
# lived only on the host (~/.config/systemd/user/needle.slice.d/{cpu,limits}.conf).
# The drop-ins set the same values and are left in place by apply-lab-fleet.sh;
# this fragment is the authoritative copy. Apply with apply-lab-fleet.sh.
#
# See README.md "CPU budget accounting" for how this quota interacts with
# launch admission (src/rate_limit/mod.rs).
[Unit]
Description=NEEDLE fleet workers (IO-capped)
Before=slices.target

[Slice]
# 2026-08-16: 4 concurrent vitest runs in one repo sustained ~1.06 GB/s of
# reads, drove io pressure to 94% and starved sshd's session setup — the box
# looked wedged (ping fine, :22 open, SSH hanging). CPU/memory caps did not
# help because they do not constrain IO.
#
# IOWeight deprioritises the fleet against system.slice (default 100), so
# sshd keeps making progress under contention.
IOWeight=50
# Hard ceiling well under the ~1 GB/s storm, but above normal build reads.
IOReadBandwidthMax=/dev/nvme0n1 500M
IOWriteBandwidthMax=/dev/nvme0n1 300M

# 2026-09-10 (needle-3d5c65d8): folded in from host-only drop-ins so the
# whole budget is tracked. 700% = 7 of the host's 12 cores; this is ALSO the
# core count launch admission sees, because available_parallelism() reads the
# cgroup quota — see README.md before changing it.
CPUWeight=100
CPUQuota=700%

# 2026-08-04, after a runaway test swarm (3 screenferry workers x ~12-way
# vitest pools = ~36 node procs) saturated NVMe and made the box unable to
# fork, requiring a power cycle. The slice had MemoryMax=infinity/TasksMax=infinity.
# These caps bound ANY dispatch in ANY repo, not just vitest.
MemoryMax=32G
MemoryHigh=24G
TasksMax=1500

# 2026-09-20 (needle-a82a5141): MemorySwapMax was infinity here, so the caps
# above bounded RSS only — in cgroup v2 swap is a separate knob, and a slice at
# MemoryMax reclaims into swap rather than failing. The overage then thrashes:
# on ex44 that day one abandoned `cargo test` held 9.3G of swap and faulted
# 1.7 TB back off disk (read_bytes 1716263055360 against 844 read syscalls),
# stalling every worker in the slice on reclaim for seven hours.
#
# 8G of lab's 24.6G swap device (/dev/nvme0n1p3), proportionally close to ex44's
# 12G of 31G. It leaves 16.6G for the rest of the host and caps worst-case
# thrash volume at 8G instead of the whole device. It also binds below the 14G
# that lab's seven workers could reach at MemorySwapMax=2G each, so it is a real
# aggregate ceiling rather than arithmetic that never trips — and it covers
# everything else in the slice too, including the cargo wrapper's sibling
# scopes. The fleet was using 0B of swap when this was set, so it bounds a
# failure mode rather than constraining present behaviour.
MemorySwapMax=8G
