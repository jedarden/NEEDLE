#!/usr/bin/env python3
"""Publish and push every bead-rs workspace's durable checkpoint, fleet-wide.

Enumerates bead-rs workspaces under a root (default $HOME, three levels deep,
scratch excluded), publishes each aligned checkpoint through the
publication-only wrapper, and pushes a branch only when every unpushed commit
is checkpoint-only. A workspace whose checkpoint is not aligned, whose branch
is detached or diverged, or whose unpushed commits carry non-checkpoint work
is skipped and recorded as an alert — never forced.

needle-4c858e12: extends the needle-32175577 publisher from a hardcoded repo
list to every bead-rs workspace, and closes the push gap that left the
git-committed handoff channel weeks stale.

The read-only --census mode reports the bead's committed-lag oracle (mtime of
.beads/checkpoint/current.json minus the last commit touching it, against the
unpushed checkpoint commits) for the 48-hour acceptance sweep, publishing and
pushing nothing.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time

# Directories never enumerated: scratch holds disposable checkouts whose
# creator owns their state; the rest cannot contain a live bead workspace.
PRUNE_DIRS = {".git", "node_modules", "target", ".cache"}
MAX_DEPTH = 3
HISTORY_LINES = 500

WRAPPER = Path.home() / ".local/bin/needle-checkpoint-unwedge"

# Outcomes that describe a healthy or merely informational state. Everything
# else in the results map is an alert.
BENIGN_OUTCOMES = {
    "in-sync", "pushed", "no-upstream", "detached", "push-dry-run",
    "upstream-not-origin",
}

# The one census outcome a healthy publisher produces: classify_workspace
# normalizes every publishable state to "aligned", so any other census
# outcome is a structural skip the sweep correctly refuses to force.
CENSUS_HEALTHY = {"aligned"}


def run(args, cwd, timeout):
    return subprocess.run(
        args, cwd=cwd, capture_output=True, text=True, timeout=timeout,
    )


def enumerate_workspaces(root):
    """Return bead-rs workspace roots at most MAX_DEPTH below root."""
    root = Path(root).resolve()
    found = []
    stack = [(root, 0)]
    while stack:
        directory, depth = stack.pop()
        try:
            entries = sorted(directory.iterdir())
        except OSError:
            continue
        for entry in entries:
            try:
                if not entry.is_dir() or entry.is_symlink():
                    continue
            except OSError:
                continue
            # Top-level dot-directories are harness state (~/.needle logs and
            # traces, ~/.config, ~/.cache), never workspace checkouts; one
            # .beads/config.json under a .needle pgdata dir is not a repo.
            if depth == 0 and entry.name.startswith("."):
                continue
            if depth == 0 and entry.name == "scratch":
                continue
            if entry.name in PRUNE_DIRS:
                continue
            try:
                if (entry / ".beads/config.json").is_file():
                    found.append(entry)
                elif depth + 1 < MAX_DEPTH:
                    stack.append((entry, depth + 1))
            except OSError:
                continue
    return sorted(found)


def git(repo, *args, timeout=60):
    return run(["git", *args], cwd=repo, timeout=timeout)


def classify_branch(repo):
    """Decide whether the branch may be pushed, and why not when it may not.

    Returns (outcome, branch_name, detail). outcome is one of: detached,
    no-upstream, upstream-not-origin, in-sync, diverged,
    unpushed-non-checkpoint, push.
    """
    branch = git(repo, "rev-parse", "--abbrev-ref", "HEAD")
    name = branch.stdout.strip() if branch.returncode == 0 else ""
    if branch.returncode:
        return "detached", name, "not a git worktree: %s" % branch.stderr.strip()[:150]
    if name == "HEAD":
        return "detached", name, "detached HEAD"
    upstream = git(
        repo, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}",
    )
    if upstream.returncode:
        return "no-upstream", name, upstream.stderr.strip()[:150]
    configured = git(repo, "config", "branch.%s.remote" % name)
    if configured.returncode or configured.stdout.strip() != "origin":
        return "upstream-not-origin", name, "branch remote: %s" % configured.stdout.strip()[:100]
    unpushed = git(repo, "rev-list", "@{u}..HEAD")
    if unpushed.returncode:
        return "diverged", name, unpushed.stderr.strip()[:150]
    shas = unpushed.stdout.split()
    if not shas:
        return "in-sync", name, ""
    behind = git(repo, "rev-list", "HEAD..@{u}")
    if behind.stdout.strip():
        return "diverged", name, "origin ahead: %d commits" % len(behind.stdout.split())
    # Only checkpoint-publication content is ours to push. A commit that
    # touches anything outside .beads/checkpoint/ belongs to another stream.
    named = git(repo, "log", "--name-only", "--format=@%H", "@{u}..HEAD")
    foreign = []
    current = None
    for line in named.stdout.splitlines():
        if line.startswith("@"):
            current = line[1:]
        elif line.strip() and not line.strip().startswith(".beads/checkpoint/"):
            foreign.append("%s %s" % (current[:12] if current else "?", line.strip()))
    if foreign:
        return "unpushed-non-checkpoint", name, "; ".join(foreign[:5])
    return "push", name, " ".join(shas)


def classify_workspace(workspace, probe=True):
    """Classify a workspace without publishing or pushing it.

    With probe (the default) the workspace's bead sync status decides the
    skip classes; with probe=False the git-level classification alone
    decides, which is what the census self-test exercises without a live
    bead workspace.
    """
    outcome, branch, detail = classify_branch(workspace)
    if outcome in ("detached", "diverged", "unpushed-non-checkpoint"):
        # Never publish onto a detached HEAD, and never publish while the
        # branch state itself is unresolved: publication would only deepen
        # the divergence.
        return outcome, branch, detail
    if not probe:
        return "aligned", branch, detail

    checks = run(
        ["bead", "sync", "status", "--format", "json"],
        cwd=workspace, timeout=30,
    )
    if checks.returncode:
        return "status-failed", branch, checks.stderr.strip()[:200]
    try:
        status = json.loads(checks.stdout)
    except ValueError:
        return "status-invalid", branch, "non-JSON sync status"
    relationship = status.get("relationship")
    if relationship != "aligned":
        return "skip-%s" % relationship, branch, "sync status relationship=%s" % relationship
    if status.get("checkpoint_consistent") is False:
        return "skip-inconsistent", branch, "checkpoint_consistent=false"
    return "aligned", branch, detail


def sweep_workspace(workspace, dry_run):
    """Publish and maybe push one workspace. Returns (outcome, detail, branch)."""
    outcome, branch, detail = classify_workspace(workspace)
    if outcome != "aligned":
        return outcome, detail, branch

    if not dry_run:
        published = run(
            [str(WRAPPER), "--workspace", str(workspace)],
            cwd=workspace, timeout=300,
        )
        if published.returncode:
            return (
                "publish-failed",
                "rc=%d %s" % (published.returncode, published.stderr.strip()[:160]),
                branch,
            )

    outcome, branch, detail = classify_branch(workspace)
    if outcome != "push":
        return outcome, detail, branch
    if dry_run:
        return "push-dry-run", detail, branch
    pushed = git(workspace, "push", "--quiet", timeout=120)
    if pushed.returncode:
        return "push-failed", pushed.stderr.strip()[:200], branch
    return "pushed", detail, branch


def census_workspace(workspace, threshold, probe=True):
    """Read-only acceptance census for one workspace (needle-4c858e12).

    lag is the bead's committed-lag oracle: mtime of the live
    .beads/checkpoint/current.json minus the commit time of the last commit
    touching it. unpushed_checkpoint counts checkpoint commits origin has
    not received. A workspace violates acceptance when lag exceeds the
    threshold with unpushed checkpoint commits and its state is one a
    healthy publisher would have converged; structural skips the sweep
    correctly refuses to force are recorded, never flagged.
    """
    outcome, branch, detail = classify_workspace(workspace, probe=probe)
    structural = outcome not in CENSUS_HEALTHY
    current = workspace / ".beads" / "checkpoint" / "current.json"
    try:
        live_mtime = current.stat().st_mtime
    except OSError:
        live_mtime = None
    committed = git(
        workspace, "log", "-1", "--format=%ct", "--",
        ".beads/checkpoint/current.json",
    )
    commit_ts = committed.stdout.strip() if committed.returncode == 0 else ""
    if live_mtime is None or not commit_ts:
        lag = None
    else:
        lag = int(live_mtime - float(commit_ts))
    unpushed = git(
        workspace, "rev-list", "@{u}..HEAD", "--", ".beads/checkpoint/",
    )
    if unpushed.returncode:
        unpushed_count = None
    else:
        unpushed_count = len(unpushed.stdout.split())
    violation = (
        not structural
        and lag is not None and lag > threshold
        and (unpushed_count or 0) > 0
    )
    return {
        "workspace": str(workspace),
        "branch": branch,
        "outcome": outcome,
        "detail": detail,
        "lag": lag,
        "unpushed_checkpoint": unpushed_count,
        "structural": structural,
        "violation": violation,
    }


def record_history(summary):
    """Append one summary line to the per-host history file."""
    state = Path(os.environ.get("NEEDLE_HOME", Path.home() / ".needle"))
    history = state / "checkpoint-sweep"
    history.mkdir(parents=True, exist_ok=True)
    history_file = history / "history.jsonl"
    try:
        lines = history_file.read_text().splitlines()[-HISTORY_LINES + 1:]
    except OSError:
        lines = []
    lines.append(json.dumps(summary, sort_keys=True))
    history_file.write_text("\n".join(lines) + "\n")


def self_test():
    """Fixture round-trips for the census oracle and the enumerator."""
    import shutil
    import tempfile
    base = Path(tempfile.mkdtemp(prefix="needle-sweep-selftest-"))
    env = dict(
        os.environ,
        GIT_AUTHOR_NAME="sweep-selftest", GIT_AUTHOR_EMAIL="sweep-selftest@example.com",
        GIT_COMMITTER_NAME="sweep-selftest", GIT_COMMITTER_EMAIL="sweep-selftest@example.com",
    )

    def gitc(repo, *args):
        result = subprocess.run(
            ["git", *args], cwd=repo, env=env, capture_output=True, text=True,
            timeout=60,
        )
        assert result.returncode == 0, "git %s failed: %s" % (args, result.stderr)
        return result

    try:
        origin = base / "origin.git"
        gitc(base, "init", "--bare", "--initial-branch=main", str(origin))
        work = base / "work"
        work.mkdir()
        gitc(work, "init", "--initial-branch=main")
        (work / ".beads" / "checkpoint").mkdir(parents=True)
        (work / ".beads" / "config.json").write_text("{}\n")
        checkpoint = work / ".beads" / "checkpoint" / "current.json"
        checkpoint.write_text("{}\n")
        gitc(work, "add", ".beads")
        gitc(work, "commit", "-m", "checkpoint")
        # A named remote, not a bare path: @{u} only resolves against a
        # remote-tracking ref, which a path push never creates.
        gitc(work, "remote", "add", "origin", str(origin))
        gitc(work, "push", "--quiet", "--set-upstream", "origin", "main")

        # The enumerator finds the fixture, and a fresh fixture is healthy:
        # everything committed and pushed, no lag, no violation.
        assert enumerate_workspaces(base) == [work], enumerate_workspaces(base)
        row = census_workspace(work, 1800, probe=False)
        assert row["outcome"] == "aligned" and row["lag"] is not None, row
        assert row["unpushed_checkpoint"] == 0 and not row["violation"], row

        # A stale, unpushed checkpoint violates acceptance: live mtime ahead
        # of the committed checkpoint, a checkpoint commit origin lacks, and
        # no structural skip in the way.
        checkpoint.write_text('{"v": 2}\n')
        gitc(work, "add", ".beads")
        gitc(work, "commit", "-m", "checkpoint v2")
        future = time.time() + 4000
        os.utime(checkpoint, (future, future))
        row = census_workspace(work, 1800, probe=False)
        assert row["outcome"] == "aligned", row
        assert row["lag"] > 1800 and row["unpushed_checkpoint"] == 1, row
        assert row["violation"], row

        # The same staleness under a foreign unpushed commit is structural:
        # the sweep correctly refuses to force another stream's branch.
        (work / "foreign.txt").write_text("not ours\n")
        gitc(work, "add", "foreign.txt")
        gitc(work, "commit", "-m", "foreign work")
        row = census_workspace(work, 1800, probe=False)
        assert row["outcome"] == "unpushed-non-checkpoint", row
        assert row["structural"] and not row["violation"], row
    finally:
        shutil.rmtree(base, ignore_errors=True)
    print("needle-checkpoint-sweep self-test passed")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", default=os.environ.get("HOME"),
                        help="directory swept for bead-rs workspaces (default $HOME)")
    parser.add_argument("--dry-run", action="store_true",
                        help="classify without publishing or pushing")
    parser.add_argument("--workspace", action="append", default=[],
                        help="sweep only this workspace (repeatable)")
    parser.add_argument("--census", action="store_true",
                        help="read-only acceptance census: report committed lag "
                             "and unpushed checkpoint commits per workspace; "
                             "never publishes or pushes; exits 1 on violations")
    parser.add_argument("--lag-threshold", type=int, default=1800,
                        help="census: seconds of committed lag beyond which a "
                             "workspace with unpushed checkpoint commits "
                             "violates acceptance (default 1800 = 2x cadence)")
    parser.add_argument("--self-test", action="store_true",
                        help="run fixture round-trips for the census oracle "
                             "and the enumerator, then exit")
    args = parser.parse_args()

    if args.self_test:
        self_test()
        return 0

    if args.workspace:
        workspaces = [Path(w).resolve() for w in args.workspace]
    elif Path(args.root).exists():
        workspaces = enumerate_workspaces(args.root)
    else:
        print("sweep root does not exist: %s" % args.root, file=sys.stderr)
        return 2

    if args.census:
        rows = []
        for workspace in workspaces:
            try:
                rows.append(census_workspace(workspace, args.lag_threshold))
            except (OSError, subprocess.TimeoutExpired) as error:
                rows.append({
                    "workspace": str(workspace), "branch": "",
                    "outcome": "error", "detail": type(error).__name__,
                    "lag": None, "unpushed_checkpoint": None,
                    "structural": True, "violation": False,
                })
        violations = [row for row in rows if row["violation"]]
        lagging = [
            row for row in rows
            if row["lag"] is not None and row["lag"] > args.lag_threshold
        ]
        counts = {}
        for row in rows:
            counts[row["outcome"]] = counts.get(row["outcome"], 0) + 1
        summary = {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "host": os.uname().nodename,
            "root": str(Path(args.root).resolve()),
            "census": True,
            "lag_threshold": args.lag_threshold,
            "workspaces": len(rows),
            "outcome_counts": counts,
            "lagging": len(lagging),
            "lagging_structural": len([r for r in lagging if r["structural"]]),
            "no_committed_checkpoint": len([r for r in rows if r["lag"] is None]),
            "violations": violations,
        }
        if args.workspace:
            for row in rows:
                print("%s: %s lag=%s unpushed=%s %s" % (
                    row["workspace"], row["outcome"], row["lag"],
                    row["unpushed_checkpoint"], row["detail"]))
        else:
            print(json.dumps(summary, sort_keys=True))
            record_history(summary)
        return 1 if violations else 0

    results = {}
    alerts = []
    pushed = []
    for workspace in workspaces:
        try:
            outcome, detail, branch = sweep_workspace(workspace, args.dry_run)
        except (OSError, subprocess.TimeoutExpired) as error:
            outcome, detail, branch = "error", type(error).__name__, ""
        results[outcome] = results.get(outcome, 0) + 1
        if outcome == "pushed":
            pushed.append({
                "workspace": str(workspace),
                "branch": branch,
                "shas": detail.split(),
            })
        elif outcome not in BENIGN_OUTCOMES:
            alerts.append({
                "workspace": str(workspace),
                "outcome": outcome,
                "detail": detail,
            })
        if args.workspace:
            print("%s: %s %s" % (workspace, outcome, detail))

    summary = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "host": os.uname().nodename,
        "root": str(Path(args.root).resolve()),
        "dry_run": args.dry_run,
        "workspaces": len(workspaces),
        "counts": results,
        "alerts": alerts,
        "pushed": pushed,
    }
    if not args.workspace:
        print(json.dumps(summary, sort_keys=True))
        record_history(summary)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
