[Unit]
Description=Publish and push durable bead-rs checkpoints for every workspace under $HOME
# Publication-only: the wrapper refuses anything not aligned, and the sweep
# pushes only checkpoint-only commits (needle-4c858e12). It never releases
# claims, restarts workers, or repairs checkpoints.

[Service]
Environment=PATH=/run/current-system/sw/bin:%h/.local/bin:%h/.cargo/bin:%h/.needle/bin
Type=oneshot
ExecStart=%h/.local/bin/needle-checkpoint-sweep
Nice=10
# Lab's serialized sweep exceeded the old 30-minute limit on 2026-10-30.
# Keep one sweep per activation, but allow the observed fleet size to finish;
# the watchdog handles the separate timer-no-next-elapse failure mode.
TimeoutStartSec=3600
